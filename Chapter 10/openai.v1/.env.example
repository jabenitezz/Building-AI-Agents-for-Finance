# Copy to .env and set your OpenAI API key.
OPENAI_API_KEY=sk-...

# Claude Sonnet 4.6 role -> GPT-5.6 Terra by default.
OPENAI_LLM_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Lower-cost model for vector embeddings.
OPENAI_EMBED_MODEL=text-embedding-3-small

# Reasoning models consume part of the completion budget internally, so this is
# intentionally larger than the original Claude max_tokens=2048.
OPENAI_MAX_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2

# Optional premium override:
# OPENAI_LLM_MODEL=gpt-5.6-sol
# OPENAI_REASONING_EFFORT=high
